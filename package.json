{
  "name": "vd-proj_final-v3",
  "version": "1.0.0",
  "type": "module",
  "description": "A cota no papel e na urna: visualização interativa da cota de gênero nas eleições brasileiras de 2022 e 2026",
  "main": "index.js",
  "scripts": {
    "build": "esbuild src/main.js --bundle --minify --outfile=dist/app.js",
    "build:vercel": "node scripts/build-vercel.mjs",
    "watch": "esbuild src/main.js --bundle --outfile=dist/app.js --watch",
    "serve": "npm run build:vercel && live-server site --port=8000",
    "dev": "esbuild src/main.js --bundle --outfile=dist/app.js --watch & live-server public --mount=/dist:./dist --mount=/data:./data --port=8000",
    "start": "npm run serve",
    "test": "node tests/e2e.mjs"
  },
  "keywords": [
    "d3",
    "eleições",
    "gênero",
    "cota",
    "TSE",
    "visualização de dados"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/newsreader": "^5.3.0",
    "@observablehq/plot": "^0.6.19",
    "d3": "^7.9.0",
    "d3-sankey": "^0.12.3",
    "esbuild": "^0.28.2",
    "gsap": "^3.15.1",
    "topojson-client": "^3.1.0"
  },
  "devDependencies": {
    "@fontsource/anton": "^5.3.0",
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/fraunces": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "live-server": "^1.2.0",
    "puppeteer": "^25.16.0"
  }
}
